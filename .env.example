# Copy to .env and fill in. See ARCHITECTURE.md for the full design.

# --- Claude (classification) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# --- Reddit (fetched on-demand per request, not polled) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=emotion-aware-analytics-system by u/your_username
REDDIT_SUBREDDITS=news,worldnews,technology
MIN_ENGAGEMENT_SCORE=20

# --- Neon Postgres (cache + opportunistic history) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Embeddings ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- Ranking ---
PRIORITY_ENGAGEMENT_WEIGHT=0.5
PRIORITY_EMOTION_WEIGHT=0.5
CLASSIFICATION_FRESHNESS_HOURS=6

# --- API ---
CORS_ORIGINS=http://localhost:3000
